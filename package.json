{
  "name": "anmorris-org-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "tsc && vite build",
    "vite:preview": "vite preview",
    "zola:dev": "zola serve --port 8080 --base-url http://localhost",
    "zola:build": "zola build",
    "check:reuse": "reuse lint",
    "check:lint": "eslint **/src/**/*",
    "check:format": "prettier -c **/*.{html,js,ts,json}",
    "check": "pnpm run --sequential \"/^check:.*/\"",
    "format": "prettier --write **/*.{html,js,ts,json}",
    "start": "pnpm run dev",
    "dev": "pnpm run \"/.*:dev$/\"",
    "build": "pnpm run --sequential \"/.*:build$/\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-jinja-template": "^2.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "katex": "^0.18.10",
    "tailwindcss": "^4.3.5"
  }
}
