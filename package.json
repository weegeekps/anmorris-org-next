{
  "name": "anmorris-org-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "tsc && vite build",
    "vite:preview": "vite preview",
    "zola:dev": "zola serve --port 8080 --base-url http://localhost:8080",
    "zola:build": "zola build",
    "check:lint": "eslint **/src/**/*",
    "check:format": "prettier -c **/*.{html,js,ts,json}",
    "check": "pnpm run \"/^check:.*/\"",
    "format": "prettier --write **/*.{html,js,ts,json}",
    "start": "pnpm run dev",
    "dev": "pnpm run \"/.*:dev$/\"",
    "build": "pnpm run \"/.*:build$/\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "prettier-plugin-jinja-template": "^2.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "katex": "^0.18.0",
    "tailwindcss": "^4.3.1"
  }
}
