{
  "name": "anmorris-org-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "tsc && vite build",
    "vite:preview": "vite preview",
    "zola:dev": "zola serve --port 8080 --base-url http://localhost",
    "zola:build": "zola build",
    "check:reuse": "reuse lint",
    "check:lint": "eslint **/src/**/*",
    "check:format:djlint": "djlint templates themes/anmorris-2026/templates --check",
    "check:format:biome": "biome format .",
    "check:format": "pnpm run --sequential \"/^check:format:[^:]+$/\"",
    "check": "pnpm run --sequential \"/^check:[^:]+$/\"",
    "format:djlint": "djlint templates themes/anmorris-2026/templates --reformat",
    "format:biome": "biome format --write .",
    "format": "pnpm run --sequential \"/^format:[^:]+$/\"",
    "start": "pnpm run dev",
    "dev": "pnpm run \"/.*:dev$/\"",
    "build": "pnpm run --sequential \"/.*:build$/\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "djlint": "^1.54.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "katex": "^0.18.10",
    "tailwindcss": "^4.3.5"
  }
}
